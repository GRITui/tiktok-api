{
  "name": "tiktok-oms",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @oms/api dev",
    "dev:worker": "pnpm --filter @oms/worker dev",
    "db:generate": "pnpm --filter @oms/db generate",
    "db:migrate": "pnpm --filter @oms/db migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
