# TikTok Shop Partner Center app credentials
TTS_APP_KEY=
TTS_APP_SECRET=
# Open API gateway and auth host (verify against Partner Center docs for your region)
TTS_API_BASE_URL=https://open-api.tiktokglobalshop.com
TTS_AUTH_BASE_URL=https://auth.tiktok-shops.com
# Service ID from Partner Center, used to build the seller authorization link
TTS_SERVICE_ID=

DATABASE_URL=postgres://oms:oms@localhost:5432/oms
REDIS_URL=redis://localhost:6379

API_PORT=3000
# 32-byte hex key used to encrypt access/refresh tokens at rest
TOKEN_ENCRYPTION_KEY=
