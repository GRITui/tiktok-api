{
  "name": "@oms/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@oms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@oms/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./types": {
      "@oms/source": "./src/oms/types.ts",
      "types": "./dist/oms/types.d.ts",
      "default": "./dist/oms/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oms/db": "workspace:*",
    "@oms/tiktok-sdk": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.4.0",
    "pdf-lib": "^1.17.1",
    "bullmq": "^5.0.0"
  }
}
